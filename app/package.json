{
  "name": "octabyteai-app",
  "version": "1.0.0",
  "description": "OctaByte AI Node.js application",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --testPathPattern='__tests__' --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:integration": "NODE_ENV=test jest --testPathPattern='integration' --forceExit",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "joi": "^17.12.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "prom-client": "^15.1.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js", "!src/__tests__/**", "!src/migrations/**"],
    "coverageThresholds": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
